# Copia este archivo como .env y rellena los valores del proyecto de Supabase.
# Solo se exponen claves publicables (anon). La service_role NUNCA va en el cliente.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Datos del negocio (nombre, teléfono, dirección, términos) ya NO viven aquí —
# se editan desde Configuración en la app (tabla business_settings).

# Cola offline (recepción/cobro/caja sin conexión). Apagada hasta validar cada fase.
VITE_OFFLINE_ENABLED=false

# Basic Auth de middleware.ts (capa extra delante de todo el panel, ver el
# comentario en ese archivo). SIN prefijo VITE_ a propósito: si lo llevara, Vite
# lo metería en el bundle público del navegador. Solo las lee middleware.ts en
# el edge (process.env), nunca el cliente. Configúralas en Vercel → Settings →
# Environment Variables del proyecto, no aquí — `npm run dev` no ejecuta este
# middleware (solo corre en Vercel / `vercel dev`), así que en local no aplican.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Correo al cliente con fotos y notas (api/send-order-email.ts). Solo las lee la
# función serverless — SIN prefijo VITE_ para que nunca lleguen al bundle.
# Configúralas en Vercel → Settings → Environment Variables. La función también
# usa VITE_SUPABASE_URL y VITE_SUPABASE_ANON_KEY (ya definidas en Vercel).
RESEND_API_KEY=
# Remitente con dominio verificado en Resend, ej: Velmont <ordenes@velmontsneakers.com>
EMAIL_FROM=
# Opcional: dónde llegan las respuestas del cliente.
EMAIL_REPLY_TO=
