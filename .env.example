# Copia este archivo como .env y rellena los valores del proyecto de Supabase.
# Solo se exponen claves publicables (anon). La service_role NUNCA va en el cliente.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Datos del negocio que salen impresos en el ticket.
VITE_BUSINESS_NAME=Velmont
VITE_BUSINESS_PHONE=
VITE_BUSINESS_ADDRESS=

# Cola offline (recepción/cobro/caja sin conexión). Apagada hasta validar cada fase.
VITE_OFFLINE_ENABLED=false
