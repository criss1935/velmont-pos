# Copia como .env en la PC del mostrador. NO se commitea.

SUPABASE_URL=https://zagpfcaizhteizqlserj.supabase.co

# service_role, NO la anon. El agente corre en una PC del local, no en el
# navegador: necesita leer y actualizar print_jobs sin pasar por RLS. Esta clave
# nunca debe salir de esta máquina ni acabar en el bundle del frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Identifica esta caja. Si mañana hay dos mostradores, cada agente escucha solo
# lo suyo y los tickets no se cruzan.
STATION_ID=mostrador-1

# IP fija de la impresora en la red del local. Si es DHCP y cambia, el agente
# deja de imprimir sin avisar: reserva la IP en el router.
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100

# Van impresos en la cabecera del ticket.
BUSINESS_ADDRESS=
BUSINESS_PHONE=

# Opcionales
# LOGO_PATH=./assets/logo-thermal-80mm.png
# TICKET_COLS=32          # 32 = ancho tipo 58mm. Una 80mm con Font A entra a 48.
# MAX_ATTEMPTS=3
# POLL_INTERVAL_MS=15000
# SOCKET_TIMEOUT_MS=8000
